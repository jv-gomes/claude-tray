# Normalise line endings: LF in the repository, native on checkout where it matters.
* text=auto eol=lf

# Explicitly text
*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.svg     text eol=lf
*.sh      text eol=lf
justfile  text eol=lf

# Windows scripts need CRLF to run correctly
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary — never diff, never normalise
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.woff    binary
*.woff2   binary
*.dmg     binary
*.exe     binary

# Generated: collapse in diffs and exclude from language statistics
Cargo.lock          linguist-generated=true -diff
/docs/**            linguist-documentation=true

# Golden reference images for icon tests — treat as binary, never normalise
/crates/claude-tray-icon/tests/golden/** binary
